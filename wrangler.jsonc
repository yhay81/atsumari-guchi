{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atsumari-guchi",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "atsumari-guchi.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["47 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atsumari-guchi",
      "database_id": "713e2912-8a3c-4935-bce8-63eae591db46",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
